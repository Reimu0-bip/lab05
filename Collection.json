              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"duplicate user\",\r\n  \"gender\": \"female\",\r\n  \"email\": \"{{createdemail}}\",\r\n  \"status\": \"active\"\r\n}",
              "options": {
