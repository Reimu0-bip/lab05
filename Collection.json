  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Tích hợp Data-Driven",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const res = pm.response.json();\r",
                  "pm.test(\"Lưu biến động userid và createdemail\", function () {\r",
                  "    pm.expect(res).to.have.property(\"id\");\r",
                  "    pm.environment.set(\"userid\", res.id);\r",
                  "    pm.environment.set(\"createdemail\", res.email);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Danh sách 3 user mô phỏng\r",
                  "const userList = [\r",
                  "    { name: \"User One\", gender: \"male\", email: \"test_user_one\", status: \"active\" },\r",
                  "    { name: \"User Two\", gender: \"female\", email: \"test_user_two\", status: \"active\" },\r",
                  "    { name: \"User Three\", gender: \"male\", email: \"test_user_three\", status: \"active\" }\r",
                  "];\r",
                  "\r",
                  "// Khởi tạo chỉ số lặp\r",
                  "let currentIndex = pm.collectionVariables.get(\"current_index\");\r",
                  "if (currentIndex === undefined || currentIndex === null) {\r",
                  "    currentIndex = 0;\r",
                  "    pm.collectionVariables.set(\"current_index\", currentIndex);\r",
                  "} else {\r",
                  "    currentIndex = parseInt(currentIndex, 10);\r",
                  "}\r",
                  "\r",
                  "// Lấy user theo lượt chạy\r",
                  "const currentUser = userList[currentIndex] || userList[0];\r",
                  "const uniqueSuffix = Date.now() + \"_\" + Math.floor(Math.random() * 1000);\r",
                  "\r",
                  "// Gán biến cho Body\r",
                  "pm.variables.set(\"dyn_name\", currentUser.name);\r",
                  "pm.variables.set(\"dyn_gender\", currentUser.gender);\r",
                  "pm.variables.set(\"dyn_email\", `${currentUser.email}_${uniqueSuffix}@gmail.com`);\r",
                  "pm.variables.set(\"dyn_status\", currentUser.status);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{dyn_name}}\",\n  \"gender\": \"{{dyn_gender}}\",\n  \"email\": \"{{dyn_email}}\",\n  \"status\": \"{{dyn_status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/public/v2/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Kiểm tra User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status code is 200 ok\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"verify retrieved user id matches requested id\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(Number(pm.environment.get(\"userid\")));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
