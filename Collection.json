        {
          "name": "Đổi status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status code is 200 ok\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"user status updated to inactive\", function () {\r",
                  "    const res = pm.response.json();\r",
                  "    pm.expect(res.status).to.eql(\"inactive\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
